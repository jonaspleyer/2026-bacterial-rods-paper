\begin{tikzpicture}[on top/.style={preaction={draw=white,-,line width=#1}},
on top/.default=4pt]
    \node (sr) [rect]   at (-4, 0)  {Spatial\\ Representation};
    \node (mo) [frect]  at (0,0)    {Computational\\ Model};
    \node (vi) [rect]   at (0,2)    {Visualization};
    \node (de) [rect]   at (0,-2)   {Data Extraction};
    \node (pe) [frect]  at (4,0)    {Parameter Estimation};
    \node (am) [rect]   at (4,-2)   {Analysis Methods};
    \node (dg) [rect]  at (4, 2)   {Data Generation};

    % Draw arrows around corner
    \path [line width=1pt]
        (sr) edge (-4,2)
        (sr) edge (-4,-2);
    \path [arrow]
        (-4,2) edge (vi)
        (-4,-2) edge (de);
    \path [arrow]
        (sr) edge (mo)
        (de) edge (am)
        (vi) edge (dg)
        % (dg) edge (cs)
        % (dg) edge (ct)
        (vi) edge (pe)
        (am) edge (pe)
        (pe) edge (dg);
    \filldraw[fill=white,draw=white] ($1/2*(mo) + 1/2*(dg)$) circle (4pt);
    \path [arrow]
        (mo) edge (dg)
        (mo) edge (pe);
    \path [arrow,<->]
        (mo) edge (am);
\end{tikzpicture}
